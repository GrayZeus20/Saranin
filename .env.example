APP_NAME=MovieFlix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Gunakan store yang persisten (redis/memcached/database) di produksi.
# "array" berarti tidak ada cache lintas request dan setiap halaman
# memanggil TMDB berkali-kali.
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

DB_CONNECTION=sqlite

REDIS_URL=
