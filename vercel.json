{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "^/(.*)$",
            "dest": "/api/index.php"
        }
    ]
}
