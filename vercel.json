{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "@vercel/php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "^/(.*)$",
            "dest": "/api/index.php"
        }
    ]
}
